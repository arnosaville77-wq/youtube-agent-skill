msgstr "Resultados e jogos de hoje de %s, e as últimas notícias."

#. translators: %s: site name.
#: includes/seo/class-seo.php:276
msgid ""
"%s: نتائج المباريات المباشرة ومواعيد مباريات اليوم والغد، جداول الترتيب "
"والهدافين، وآخر أخبار كرة القدم وباقي الرياضات."
msgstr ""
"%s: resultados ao vivo, jogos de hoje e amanhã, classificações e artilheiros"
" e as últimas notícias de futebol e outros esportes."
